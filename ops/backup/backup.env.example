# Copy to /root/.config/career-backup/backup.env and `chmod 600` it.
# This file holds SECRETS and must never be committed (it lives outside the repo).

# --- restic repository: Backblaze B2 native backend ---
# Format: b2:<bucket-name>:<path>.  Use a "staging" path prefix in the bucket.
RESTIC_REPOSITORY=b2:YOUR_BUCKET_NAME:staging

# --- Backblaze B2 application key (RESTRICTED to the bucket above) ---
# From the B2 "Application Keys" page: keyID -> B2_ACCOUNT_ID, applicationKey -> B2_ACCOUNT_KEY.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# --- restic repo encryption password ---
# Generate a strong random value AND store a copy in your password manager.
# Without this password the encrypted backups are permanently unrecoverable.
RESTIC_PASSWORD=

# --- Database / container (defaults already match staging) ---
PG_CONTAINER=career_staging-postgres-1
DB_OWNER_USER=career_owner
DB_NAME=career_staging
STORAGE_VOLUME=career_staging_storage_data

# --- Retention ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
