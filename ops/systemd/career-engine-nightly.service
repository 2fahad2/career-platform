# Nightly discovery/gate/rank run (whitepaper §06, C6).
# Digest-only by default (D9) — the engine has no send path; delivery is C7.
# Runs on the host venv against the published staging Postgres port.
[Unit]
Description=Career platform nightly engine run (discover -> gate -> rank)
Wants=network-online.target
After=network-online.target docker.service
OnFailure=career-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/career
EnvironmentFile=/root/career/.env.staging
# Host-side overrides MUST ride inside ExecStart: systemd applies
# EnvironmentFile AFTER Environment= lines, so plain overrides lose.
# .env.staging is written for the compose network (postgres/redis hostnames).
ExecStart=/usr/bin/env DB_HOST=127.0.0.1 DB_PORT=5433 REDIS_HOST=127.0.0.1 REDIS_PORT=6380 STORAGE_ROOT=/root/career/data /root/career/.venv/bin/python /root/career/scripts/run_nightly.py
