# ── PRODUCTION environment (Saudi server — moving there is a wave-2 exit gate) ──
# CHANGELOG-v1.1 §2: production must run on a Saudi server before the first
# real-price customer. This file documents the shape; the real .env.production
# lives ONLY on the production host with its own secrets. staging and production
# share NOTHING — separate DBs, separate credentials, separate volumes.
#
# This file is a BUILD CHECKLIST, not a description: the disaster runbook fills
# the secrets file from it by hand. A key missing here is a production host that
# boots green on a default — five of them were, and each one broke the money or
# the delivery path in silence. tests/test_env_templates.py now derives the
# required set from the code, so the next omission fails in CI instead.
CAREER_ENV=production

# Compose project name isolates production containers/volumes/networks. Read by
# docker compose itself (never by the app): a wrong value builds a SECOND empty
# environment beside the real one, with its own database volume.
COMPOSE_PROJECT_NAME=career_production

# --- Postgres (production) — own database, own credentials ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=career_production
DB_USER=career_app
DB_PASSWORD=production-app-password-CHANGE-ME
DB_OWNER_USER=career_owner
DB_OWNER_PASSWORD=production-owner-password-CHANGE-ME

# Host-published ports (production range) — distinct from staging. All three are
# interpolated by docker-compose.production.yml, and API_PUBLISH_PORT is also
# what the watchtower probes for the running commit: point it at a port nothing
# answers on and the deploy-drift check degrades to «unknown», not to an alarm.
DB_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000

# --- Redis (production) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=production-redis-password-CHANGE-ME

# --- Storage (production) ---
# ABSOLUTE, always. The code default is a relative ./data, which two processes
# with different working directories resolve to two different trees — the
# customer's files end up split and the backup covers only the tree it was
# pointed at. Inside the container this is the storage_data volume mount.
STORAGE_ROOT=/data

# --- CV upload malware scanning (§11 step 3) ---
# Path to clamd's unix socket, e.g. /var/run/clamav/clamd.ctl on Debian.
# EMPTY IS A DECLARED POSTURE, NOT A GAP: with no path there is no engine on
# this host, uploads are accepted after every other §11 control (magic sniff,
# structural inspection, sanitization, sandboxed extraction) and the row is
# recorded as `unscanned` instead of `clean`. The watchtower health screen
# shows «غير مركّب — الملفات تمر بلا فحص» for as long as that is true. Fill
# this in the moment clamav is installed, and the same screen turns green.
CV_SCAN_CLAMD_SOCKET=
# Seconds to wait on the socket. A configured engine that does not answer
# inside this REJECTS the upload (ScanPolicy.on_unavailable) — a customer who
# can retry beats a payload that walks through a hung daemon.
CV_SCAN_TIMEOUT_S=8.0

# --- Anthropic (CV generation — the only LLM provider) ---
ANTHROPIC_API_KEY=

LOG_LEVEL=INFO

# --- SearchAPI.io (Google Jobs discovery — C6, deviation D13) ---
# Without this the nightly run exits 2 before it starts: no customer is
# searched for at all, every day, and the only symptom is an absence.
SEARCHAPI_API_KEY=
# nightly engine caps (§06 — configuration, not code)
ENGINE_MAX_PER_QUERY=5
ENGINE_RETRIEVAL_CAP=50
ENGINE_ENRICH_CAP=30

# --- §14 cost metering: provider list prices (USD), settings not code ---
# SearchAPI.io per google_jobs search credit
SEARCHAPI_USD_PER_SEARCH=0.004
# Meta template message, per category, Saudi Arabia market.
# MEASURED 2026-08-08 off Meta's live KSA rate card (Business Manager),
# the same reading the template categories were taken from; corrected here
# 2026-08-10. Until then these templates shipped 0.0157 / 0.0384 — the
# pre-2026-04-01 card — so a host built from one silently undid the code
# default and billed utility 47% high and marketing 23% low. The real
# multiple is ~4.7x, not the ~2.4x older comments assumed.
# Same pair as the defaults in src/career/config.py, which carries the full
# note: re-read the card before changing either, and change both.
WHATSAPP_USD_PER_UTILITY_MESSAGE=0.0107
WHATSAPP_USD_PER_MARKETING_MESSAGE=0.0501

# --- Salla (billing/webhooks — C3; filled when Partner App is created) ---
SALLA_WEBHOOK_SECRET=
SALLA_API_KEY=
# The OAuth trio. The code does not refresh the access token yet — a human
# does, from the Salla partner dashboard, and he cannot do it on a host that
# does not carry these. The token dies quietly and the first symptom is a paid
# order that provisions nothing.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REFRESH_TOKEN=
# product id -> plan code JSON map, e.g. {"123":"professional","456":"cv_analysis"}
# EMPTY MEANS NO ORDER IS EVER PROVISIONED: the customer pays and receives
# silence. Fill it from scripts/wire_salla_products.py; the boot check
# (engine/cli.verify_environment) shouts every morning until it is right.
SALLA_PRODUCT_CATALOG={}
# product id -> [amount, currency], e.g. {"123":["199.00","SAR"]}
# The §09 triple match compares the paid amount against THIS. Empty means every
# real order fails closed to manual review — safe, and still a dead storefront.
SALLA_PRODUCT_PRICING={}
# captured access-token expiry ISO date (manual until auto-refresh lands)
SALLA_TOKEN_EXPIRES_AT=
# LAST DAY (ISO, Riyadh) of a deliberate test price on the REAL products —
# the 1-riyal payment-gateway proof. EMPTY = no window, which is the normal
# posture. While it is set, no founder price lock is captured: a lock taken
# from a test price would authorise buying the real pass for that price and
# would fail that customer's next real payment closed. Written and cleared by
# scripts/wire_salla_products.py together with the pricing map, never alone.
SALLA_PRICE_TEST_UNTIL=
# storefront the customer renews from (§16) — empty = no link is printed, so an
# expiring customer is told to renew with no way to do it
SALLA_STORE_URL=

# --- WhatsApp Cloud API (C4; filled when Meta app + WABA are set up) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NUMBER_E164=
# Without the WABA id the template-status probe is SKIPPED rather than failed,
# so a template still PENDING at Meta is discovered by a send that does not
# arrive — on the morning it was supposed to arrive.
WHATSAPP_WABA_ID=
# Operator reference for the Meta app dashboard; not read by the code today.
META_APP_ID=

# --- Telegram admin channel (C4; bot token must be rotated before live) ---
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Canary phase: the operator's own WhatsApp number (evening window nudge)
CANARY_TEST_PHONE=
