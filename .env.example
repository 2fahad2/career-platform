# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to `.env` (untracked) and fill real values.
# NEVER commit a real .env. No secret may ever appear in git, logs, or errors
# (whitepaper §15 invariant 15 / CLAUDE.md).
#
# Per-environment files (.env.staging / .env.production) are separate and hold
# DISTINCT secrets and databases — the two environments never share credentials.
# See .env.staging.example and .env.production.example.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process serves: staging | production
CAREER_ENV=staging

# Compose project name isolates this environment's containers/volumes/networks.
# Read by docker compose itself, never by the app.
COMPOSE_PROJECT_NAME=career_local

# --- Postgres (application role — NOT a superuser; RLS must apply) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career
DB_USER=career_app
DB_PASSWORD=change-me-app-password

# Owner/migration role (runs Alembic; owns the tables). Kept separate from the
# app role so the app connection is always subject to RLS.
DB_OWNER_USER=career_owner
DB_OWNER_PASSWORD=change-me-owner-password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# Host-published ports: interpolated by the compose files, so an absent one
# publishes nothing. API_PUBLISH_PORT is also the port the watchtower probes
# for the running commit — the code default (8000) is not the staging port, and
# a probe pointed at silence reports «unknown» rather than «drifted».
DB_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000

# --- Object storage (filesystem-backed StorageAdapter for now) ---
# ABSOLUTE, always. The code default is a relative ./data, and two processes
# with different working directories resolve that to two different trees — the
# customer's files split across both, and the backup covers only one of them.
STORAGE_ROOT=/root/career/data

# --- CV upload malware scanning (§11 step 3) ---
# Path to clamd's unix socket, e.g. /var/run/clamav/clamd.ctl on Debian.
# EMPTY IS A DECLARED POSTURE, NOT A GAP: with no path there is no engine on
# this host, uploads are accepted after every other §11 control (magic sniff,
# structural inspection, sanitization, sandboxed extraction) and the row is
# recorded as `unscanned` instead of `clean`. The watchtower health screen
# shows «غير مركّب — الملفات تمر بلا فحص» for as long as that is true. Fill
# this in the moment clamav is installed, and the same screen turns green.
CV_SCAN_CLAMD_SOCKET=
# Seconds to wait on the socket. A configured engine that does not answer
# inside this REJECTS the upload (ScanPolicy.on_unavailable) — a customer who
# can retry beats a payload that walks through a hung daemon.
CV_SCAN_TIMEOUT_S=8.0

# --- Anthropic (CV generation — the only LLM provider; whitepaper locked) ---
# Not used until C7. Leave blank in C1/C2.
ANTHROPIC_API_KEY=

# --- SearchAPI.io (Google Jobs discovery — C6; deviation D13) ---
SEARCHAPI_API_KEY=
# nightly engine caps (§06 — configuration, not code)
ENGINE_MAX_PER_QUERY=5
ENGINE_RETRIEVAL_CAP=50
ENGINE_ENRICH_CAP=30

# --- §14 cost metering: provider list prices (USD), settings not code ---
# SearchAPI.io per google_jobs search credit
SEARCHAPI_USD_PER_SEARCH=0.004
# Meta template message, per category, Saudi Arabia market.
# MEASURED 2026-08-08 off Meta's live KSA rate card (Business Manager),
# the same reading the template categories were taken from; corrected here
# 2026-08-10. Until then these templates shipped 0.0157 / 0.0384 — the
# pre-2026-04-01 card — so a host built from one silently undid the code
# default and billed utility 47% high and marketing 23% low. The real
# multiple is ~4.7x, not the ~2.4x older comments assumed.
# Same pair as the defaults in src/career/config.py, which carries the full
# note: re-read the card before changing either, and change both.
WHATSAPP_USD_PER_UTILITY_MESSAGE=0.0107
WHATSAPP_USD_PER_MARKETING_MESSAGE=0.0501

# --- App ---
LOG_LEVEL=INFO

# --- Salla (billing/webhooks — C3; filled when Partner App is created) ---
SALLA_WEBHOOK_SECRET=
SALLA_API_KEY=
# The OAuth trio, held for the manual token refresh; not read by the code
# today. A human refreshes the access token from the partner dashboard and
# cannot do it on a host that does not carry these.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REFRESH_TOKEN=
# product id -> plan code JSON map, e.g. {"123":"professional","456":"cv_analysis"}
SALLA_PRODUCT_CATALOG={}
# product id -> [amount, currency], e.g. {"123":["279.00","SAR"]}
SALLA_PRODUCT_PRICING={}
# captured access-token expiry ISO date (manual until auto-refresh lands)
SALLA_TOKEN_EXPIRES_AT=
# LAST DAY (ISO, Riyadh) of a deliberate test price on the REAL products —
# the 1-riyal payment-gateway proof. EMPTY = no window, which is the normal
# posture. While it is set, no founder price lock is captured: a lock taken
# from a test price would authorise buying the real pass for that price and
# would fail that customer's next real payment closed. Written and cleared by
# scripts/wire_salla_products.py together with the pricing map, never alone.
SALLA_PRICE_TEST_UNTIL=
# storefront the customer renews from (§16) — empty = no link is printed
SALLA_STORE_URL=

# --- WhatsApp Cloud API (C4; filled when Meta app + WABA are set up) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NUMBER_E164=
# Without the WABA id the template-status probe is SKIPPED rather than failed,
# so a template still PENDING at Meta is discovered by a send that never lands.
WHATSAPP_WABA_ID=
# Operator reference for the Meta app dashboard; not read by the code today.
META_APP_ID=

# --- Telegram admin channel (C4; bot token must be rotated before live) ---
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Canary phase: the operator's own WhatsApp number (evening window nudge)
CANARY_TEST_PHONE=
