# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to `.env` (untracked) and fill real values.
# NEVER commit a real .env. No secret may ever appear in git, logs, or errors
# (whitepaper §15 invariant 15 / CLAUDE.md).
#
# Per-environment files (.env.staging / .env.production) are separate and hold
# DISTINCT secrets and databases — the two environments never share credentials.
# See .env.staging.example and .env.production.example.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process serves: staging | production
CAREER_ENV=staging

# --- Postgres (application role — NOT a superuser; RLS must apply) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career
DB_USER=career_app
DB_PASSWORD=change-me-app-password

# Owner/migration role (runs Alembic; owns the tables). Kept separate from the
# app role so the app connection is always subject to RLS.
DB_OWNER_USER=career_owner
DB_OWNER_PASSWORD=change-me-owner-password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# --- Object storage (filesystem-backed StorageAdapter for now) ---
STORAGE_ROOT=./data

# --- Anthropic (CV generation — the only LLM provider; whitepaper locked) ---
# Not used until C7. Leave blank in C1/C2.
ANTHROPIC_API_KEY=

# --- App ---
LOG_LEVEL=INFO
